# One refclient instance, against a real agrirouter.
#
# Copy to .env.qa or .env.prod and fill in. The compose stack does not read
# these: it runs against the test router, where the only credential is a bearer
# token agrirouter resolves to nothing but itself.
#
#   refclient --env-file is not a thing; export these and run, or pass them
#   through your process manager.

# Which agrirouter.
AGMASYNC_URL=https://api.qa.agrirouter.farm

# The farming business this participant is onboarded into. The one thing an
# instance has to be told: the endpoint is created on startup by
# PUT /endpoints/{external_id}, and agrirouter answers with its id.
AGMASYNC_TENANT_ID=<uuid>

# This participant's application, as registered in application-service. Two
# instances meant to exchange with each other need two of these — the live
# stream is per application, and so is the identifier mapping.
AGMASYNC_APPLICATION_ID=<uuid>
AGMASYNC_SOFTWARE_VERSION_ID=<uuid>

# Credentials. Against a real agrirouter these are OAuth client credentials, and
# the scopes are the two in openapi.yaml: manage_endpoints to create and
# configure the endpoint, masterdata for everything it then exchanges.
AGMASYNC_OAUTH_TOKEN_URL=https://api.qa.agrirouter.farm/oauth/token
AGMASYNC_OAUTH_CLIENT_ID=<client-id>
AGMASYNC_OAUTH_CLIENT_SECRET=<client-secret>

# Against the test router, instead of the three above: a static bearer token,
# which it treats as the application identifier.
# AGMASYNC_TOKEN=<application-uuid>

# What to call this participant, and where to put its database and its screens.
REFCLIENT_INSTANCE=alpha
REFCLIENT_DB=alpha.db
REFCLIENT_ADDR=:8081

# How long an initial load waits for a person before giving up on an object and
# leaving it for one. A load with a question outstanding is stopped, so this is
# also how long a database transaction may stay open.
REFCLIENT_DECISION_TIMEOUT=2m

# ---- Routing ----
#
# There is nothing here for it. Which entity types an endpoint exchanges is the
# user's decision, made in agrirouter, and a participant only learns of it on
# the stream. Against the test router, `agmactl route` stands in for the user.
