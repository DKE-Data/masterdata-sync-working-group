# The two participants of docker-compose.yml, against a real agrirouter.
#
# Copy to env/qa.env or env/prod.env, fill in, and name it on the command line.
# It is read for variable substitution, not handed to the containers, which is
# why the names here differ from the AGMASYNC_* ones the program reads: the
# compose file maps them per participant. The difference is not only tidiness —
# a variable exported in the shell beats one read from an --env-file, and a
# shell that has run agmactl already has AGMASYNC_URL set.
#
#   docker compose --env-file env/qa.env up -d alpha beta
#   docker compose --env-file env/qa.env run --rm agmactl -instance alpha status
#
# Name alpha and beta rather than bringing the whole stack up: the local test
# router has no part in this, and nothing depends on it.
#
# Everything below has a working default in docker-compose.yml pointing at the
# test router, so a file that sets only some of these leaves the rest local —
# which is a confusing halfway house rather than a useful one. Set all of them.

# ---- Which agrirouter, and whose data ----

AGRIROUTER_URL=https://api.qa.agrirouter.farm

# agrirouter's own front end, where a user authorizes an application for their
# farming business. Without it an unauthorized participant can only report that
# it is unauthorized; with it, it sends the person there and waits.
#
# It is the front end, not the API host: /api/authorize is a route of the
# agrirouter web app, and the API host knows nothing about it.
#
#   qa    https://app-qa.agrirouter.com
#   prod  https://app.agrirouter.com
AGRIROUTER_APP_URL=https://app-qa.agrirouter.com

# The farming business both participants are onboarded into. Each creates its
# endpoint on startup and agrirouter answers with the id, so nothing is copied
# out of a screen.
#
# It may be left empty where AGRIROUTER_APP_URL is set: authorizing answers
# "which farming business" as its whole point, and the participant takes the
# tenant from the redirect that comes back. Set it and the two must agree —
# authorizing a different one is refused rather than adopted, since the database
# belongs to whichever it was.
AGRIROUTER_TENANT_ID=

# ---- alpha ----
#
# Two participants means two applications, not two endpoints of one. The live
# stream is per application and so is the identifier mapping, so two instances
# sharing an application would share both.

ALPHA_APPLICATION_ID=
ALPHA_SOFTWARE_VERSION_ID=

# Credentials. A real agrirouter takes OAuth client credentials; the scopes are
# the two in openapi.yaml, and the participant asks for both — manage_endpoints
# to create and configure the endpoint, masterdata for what it then exchanges.
#
# The token endpoint is on its own host, not the API one:
#
#   qa    https://oauth.qa.agrirouter.farm/token
#   prod  https://api-oauth.agrirouter.com/token
#
# Pointing this at <api host>/oauth/token instead reaches the API gateway, which
# answers 401 "Authorization header must start with 'Bearer '" — a sentence
# about the API's own auth, not about these credentials.
#
# Leave ALPHA_TOKEN empty. It is the test router's static bearer, and a token
# set alongside a token URL would be the one used.
ALPHA_TOKEN=
ALPHA_OAUTH_TOKEN_URL=https://oauth.qa.agrirouter.farm/token
ALPHA_OAUTH_CLIENT_ID=
ALPHA_OAUTH_CLIENT_SECRET=

# Scopes to ask for, shared by both participants. Empty is what QA and
# production want: they grant what the client is registered for, and answer
# invalid_scope to a request naming the two scopes openapi.yaml documents.
# OAUTH_SCOPES=manage_endpoints,masterdata

# ---- beta ----

BETA_APPLICATION_ID=
BETA_SOFTWARE_VERSION_ID=
BETA_TOKEN=
BETA_OAUTH_TOKEN_URL=https://oauth.qa.agrirouter.farm/token
BETA_OAUTH_CLIENT_ID=
BETA_OAUTH_CLIENT_SECRET=

# Where agrirouter sends the person back to. Defaults to the published port of
# each participant, which is what a browser on this machine reaches. Each must
# be a registered redirect of that participant's OAuth client, or agrirouter
# refuses to send anybody back to it.

# ALPHA_PUBLIC_URL=http://localhost:8081
# BETA_PUBLIC_URL=http://localhost:8082

# ---- Ports on this machine ----
#
# Only where the defaults are taken. Inside the network nothing moves.

# TESTROUTER_PORT=8080
# ALPHA_PORT=8081
# BETA_PORT=8082

# ---- Routing ----
#
# Nothing here for it. Which entity types an endpoint exchanges is the user's
# decision, made in agrirouter, and a participant only learns of it on the
# stream. `agmactl route` stands in for the user against the test router and has
# nothing to call against a real agrirouter.
